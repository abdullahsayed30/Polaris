{
  "realm": "polaris",
  "enabled": true,
  "displayName": "Polaris local development",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "A Polaris customer who owns orders"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "orders:read",
      "description": "Read orders owned by the authenticated customer",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "orders:write",
      "description": "Place orders for the authenticated customer",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "polaris-cli",
      "name": "Polaris local demo CLI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "orders:read",
        "orders:write"
      ],
      "protocolMappers": [
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "alice",
      "firstName": "Alice",
      "lastName": "Customer",
      "email": "alice@polaris.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice-demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "bob",
      "firstName": "Bob",
      "lastName": "Customer",
      "email": "bob@polaris.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob-demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    }
  ]
}

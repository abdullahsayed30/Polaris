{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "infrastructure", "services", "networkPolicy"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["deploymentEnvironment"],
      "properties": {
        "deploymentEnvironment": {"type": "string", "minLength": 1}
      }
    },
    "infrastructure": {
      "type": "object",
      "required": ["databases", "kafka", "redis", "oidc", "tracing"],
      "properties": {
        "databases": {
          "type": "object",
          "required": ["order", "inventory", "notification"],
          "properties": {
            "order": {"$ref": "#/definitions/database"},
            "inventory": {"$ref": "#/definitions/database"},
            "notification": {"$ref": "#/definitions/database"}
          }
        },
        "kafka": {
          "type": "object",
          "required": ["bootstrapServers"],
          "properties": {"bootstrapServers": {"type": "string", "minLength": 1}}
        },
        "redis": {
          "type": "object",
          "required": ["host", "port"],
          "properties": {
            "host": {"type": "string", "minLength": 1},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        },
        "oidc": {
          "type": "object",
          "required": ["issuerUri", "jwkSetUri"],
          "properties": {
            "issuerUri": {"type": "string", "format": "uri"},
            "jwkSetUri": {"type": "string", "format": "uri"}
          }
        },
        "tracing": {
          "type": "object",
          "required": ["enabled", "endpoint", "samplingProbability"],
          "properties": {
            "enabled": {"type": "boolean"},
            "endpoint": {"type": "string", "format": "uri"},
            "samplingProbability": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"}
          }
        }
      }
    },
    "services": {
      "type": "object",
      "required": ["gateway", "order-service", "inventory-service", "notification-service"],
      "properties": {
        "gateway": {"$ref": "#/definitions/service"},
        "order-service": {"$ref": "#/definitions/service"},
        "inventory-service": {"$ref": "#/definitions/service"},
        "notification-service": {"$ref": "#/definitions/service"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "egress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "egress": {
          "type": "object",
          "required": ["allowAll"],
          "properties": {"allowAll": {"type": "boolean"}}
        }
      }
    }
  },
  "definitions": {
    "database": {
      "type": "object",
      "required": ["url", "existingSecret", "usernameKey", "passwordKey"],
      "properties": {
        "url": {"type": "string", "pattern": "^jdbc:postgresql://"},
        "existingSecret": {"type": "string", "minLength": 1},
        "usernameKey": {"type": "string", "minLength": 1},
        "passwordKey": {"type": "string", "minLength": 1}
      }
    },
    "service": {
      "type": "object",
      "required": ["enabled", "replicaCount", "image", "httpPort", "ports", "service", "probes", "resources", "podDisruptionBudget", "autoscaling"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 1},
        "httpPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "grpcPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "image": {
          "type": "object",
          "required": ["repository", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string"},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/port"}
        },
        "service": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
            "annotations": {"type": "object"}
          }
        },
        "extraEnv": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        },
        "secretEnv": {
          "type": "array",
          "items": {"$ref": "#/definitions/secretEnv"}
        },
        "probes": {
          "type": "object",
          "required": ["timeoutSeconds", "startup", "readiness", "liveness"],
          "properties": {
            "timeoutSeconds": {"type": "integer", "minimum": 1},
            "startup": {"$ref": "#/definitions/probeTiming"},
            "readiness": {"$ref": "#/definitions/probeTiming"},
            "liveness": {"$ref": "#/definitions/probeTiming"}
          }
        },
        "resources": {
          "type": "object",
          "required": ["requests", "limits"]
        },
        "podDisruptionBudget": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minAvailable": {"type": ["integer", "string"]},
            "maxUnavailable": {"type": ["integer", "string"]}
          }
        },
        "autoscaling": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
          "properties": {
            "enabled": {"type": "boolean"},
            "minReplicas": {"type": "integer", "minimum": 1},
            "maxReplicas": {"type": "integer", "minimum": 1},
            "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100},
            "targetMemoryUtilizationPercentage": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        }
      }
    },
    "port": {
      "type": "object",
      "required": ["name", "containerPort", "servicePort", "appProtocol"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"},
        "containerPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "servicePort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "protocol": {"enum": ["TCP", "UDP", "SCTP"]},
        "appProtocol": {"type": "string", "minLength": 1}
      }
    },
    "probeTiming": {
      "type": "object",
      "required": ["failureThreshold", "periodSeconds"],
      "properties": {
        "failureThreshold": {"type": "integer", "minimum": 1},
        "periodSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "secretEnv": {
      "type": "object",
      "required": ["name", "secretName", "secretKey"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "secretName": {"type": "string", "minLength": 1},
        "secretKey": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"}
      }
    }
  }
}

{
  "title": "Polaris gRPC",
  "uid": "polaris-grpc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "polaris"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Inventory RPC server request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(method,statusCode) (rate(grpc_server_processing_duration_seconds_count{service=\"polaris.inventory.v1.InventoryService\"}[5m]))",
          "legendFormat": "{{method}} {{statusCode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Inventory RPC client request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(method,statusCode) (rate(grpc_client_processing_duration_seconds_count{service=\"polaris.inventory.v1.InventoryService\"}[5m]))",
          "legendFormat": "{{method}} {{statusCode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Inventory RPC p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,method) (rate(grpc_server_processing_duration_seconds_bucket{service=\"polaris.inventory.v1.InventoryService\"}[5m])))",
          "legendFormat": "{{method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Inventory RPC system errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(method,statusCode) (rate(grpc_server_processing_duration_seconds_count{service=\"polaris.inventory.v1.InventoryService\",statusCode=~\"UNKNOWN|INTERNAL|UNAVAILABLE|DEADLINE_EXCEEDED|DATA_LOSS|RESOURCE_EXHAUSTED\"}[5m]))",
          "legendFormat": "server {{method}} {{statusCode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by(method,statusCode) (rate(grpc_client_processing_duration_seconds_count{service=\"polaris.inventory.v1.InventoryService\",statusCode=~\"UNKNOWN|INTERNAL|UNAVAILABLE|DEADLINE_EXCEEDED|DATA_LOSS|RESOURCE_EXHAUSTED\"}[5m]))",
          "legendFormat": "client {{method}} {{statusCode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    }
  ],
  "links": [
    {
      "title": "Tempo trace search",
      "url": "/explore?schemaVersion=1&panes={\"trace\":{\"datasource\":\"Tempo\",\"queries\":[{\"refId\":\"A\",\"queryType\":\"traceql\",\"query\":\"{resource.service.namespace=\\\"polaris\\\"}\"}],\"range\":{\"from\":\"now-30m\",\"to\":\"now\"}}}",
      "type": "link",
      "targetBlank": true
    }
  ]
}

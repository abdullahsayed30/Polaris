{
  "title": "Polaris Business Flow",
  "uid": "polaris-business-flow",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "polaris"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Pending orders (committed snapshot)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(job) (polaris_pending_orders and on(job,instance) (polaris_observability_snapshot_success == 1) and on(job,instance) (time() - polaris_observability_snapshot_timestamp_seconds < 45))",
          "legendFormat": "{{job}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    },
    {
      "id": 2,

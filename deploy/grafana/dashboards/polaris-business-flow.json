      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(event_type,outcome) (increase(polaris_notification_completions_total[5m]))",
          "legendFormat": "{{event_type}} {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Notification processing freshness p95 (overflow suppressed)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,event_type) (rate(polaris_notification_freshness_seconds_bucket[5m]) and on(job,instance,event_type) rate(polaris_notification_freshness_seconds_bucket{le=\"604800.0\"}[5m]))) and on(event_type) (sum by(event_type) (rate(polaris_notification_freshness_seconds_bucket{le=\"604800.0\"}[5m])) >= 0.95 * (sum by(event_type) (rate(polaris_notification_freshness_seconds_count[5m]) and on(job,instance,event_type) rate(polaris_notification_freshness_seconds_bucket{le=\"604800.0\"}[5m])) > 0))",
          "legendFormat": "{{event_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          }
        }
      ],
      "description": "Completed simulated processing only. Finite buckets extend to 7 days. A series is hidden when more than 5% of completed observations exceed 7 days, because its p95 lies in the infinite bucket; inspect the overflow panel. Missing data is not zero freshness. During rolling upgrades, replicas without the 7-day bucket are excluded until they publish the new histogram. No completed observations also produce no p95 series."
    },

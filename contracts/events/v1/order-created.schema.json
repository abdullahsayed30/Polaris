{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://polaris.example/contracts/events/v1/order-created.schema.json",
  "title": "OrderCreated",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "orderId", "customerId", "status", "items", "createdAt"],
  "properties": {
    "metadata": {"$ref": "#/$defs/metadata"},
    "orderId": {"type": "string", "format": "uuid"},
    "customerId": {"type": "string", "format": "uuid"},
    "status": {"type": "string", "enum": ["PENDING", "CONFIRMED", "CANCELLED"]},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    },
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "version", "occurredAt", "correlationId", "causationId"],
      "properties": {
        "eventId": {"type": "string", "format": "uuid"},
        "version": {"const": 1},
        "occurredAt": {"type": "string", "format": "date-time"},
        "correlationId": {"type": ["string", "null"]},
        "causationId": {"type": ["string", "null"], "format": "uuid"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "sku", "quantity", "unitPrice"],
      "properties": {
        "itemId": {"type": "string", "format": "uuid"},
        "sku": {"type": "string", "minLength": 1, "maxLength": 128},
        "quantity": {"type": "integer", "minimum": 1},
        "unitPrice": {"type": "number", "minimum": 0.01}
      }
    }
  }
}
